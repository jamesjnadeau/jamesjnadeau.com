//- The ContentTools management screens: the markdown pages that can be edited,
//- changes waiting for review, and a link from each page to the page itself.
//- The words are edited on the published page (static/cms/boot.js); pressing
//- Edit here opens it.
//-
//- Its own page rather than the site layout, because the editor takes the
//- whole viewport. Authors sign in with Netlify Identity: the sign-in screen's
//- button opens the Identity widget (static/cms/netlify.js), and every change
//- is saved as a pull request through Netlify's Git Gateway. The widget loads
//- as the page starts, so an invite or password-reset link that lands here is
//- finished here.
//-
//- Only works where Netlify serves the site: GitHub Pages has no /.netlify/
//- endpoints behind it.
doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1.0')
    meta(name='robots' content='noindex')
    title= title
    meta(name='description' content=description)
    link(rel='icon' type='image/png' href='/icons/favicon-32x32.png')
    style.
      html, body { height: 100%; }
      body { margin: 0; }
      content-tools-cms { display: block; height: 100%; }
      .pug-link {
        position: fixed; left: 1rem; bottom: 1rem; z-index: 1;
        padding: .4rem .8rem; border-radius: 4px; background: #333; color: #fff;
        font: 14px system-ui, sans-serif; text-decoration: none;
      }
  body
    noscript
      p Editing the site needs JavaScript enabled.
    //- The screens below edit markdown. Pug posts have their own editor,
    //- with the source beside a live preview (content/admin/pug.pug).
    a.pug-link(href='/admin/pug/') Edit Pug posts →
    //- Created from script rather than written as a tag, so `auth` and
    //- `fetch` are assigned after the element is defined and before it
    //- loads its config: a property set on a not-yet-upgraded element
    //- would hide the element's own accessor instead of calling it.
    script(type='module').
      import '/cms/shell.js';
      import { IdentityAdapter, gatewayFetch } from '/cms/netlify.js';

      const cms = document.createElement('content-tools-cms');
      cms.auth = new IdentityAdapter();
      cms.fetch = gatewayFetch();
      cms.setAttribute('config', '/cms-config.yml');
      document.body.append(cms);
