---
title: Edit Pug Posts | James J Nadeau
description: Edit this site's Pug posts with their source beside a live preview.
eleventyExcludeFromCollections: true
permalink: /admin/pug/
layout: false
---
//- The Pug editor: a Pug post's source beside a live preview of the page it
//- becomes, saved as a pull request. The markdown pages are edited in place
//- instead (/admin/); ContentTools can't edit Pug, which has no markdown to
//- write back. Everything this page does is in cms-src/pug-editor.js, bundled
//- into /cms-pug/ by .eleventy.js; this is its markup and layout.
//-
//- Like /admin/, it only works where Netlify serves the site: sign-in and
//- saves go through /.netlify/.
doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1.0')
    meta(name='robots' content='noindex')
    title= title
    meta(name='description' content=description)
    link(rel='icon' type='image/png' href='/icons/favicon-32x32.png')
    style.
      :root {
        --bg: #f6f6f4; --panel: #ffffff; --text: #1d1d1b; --muted: #5f5f5a;
        --line: #d9d9d4; --accent: #333333; --error-bg: #fdecea; --error: #8a1c10;
        color-scheme: light;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html, body { height: 100%; margin: 0; background: var(--bg); color: var(--text); }
      body { display: flex; flex-direction: column; }
      header, footer {
        display: flex; flex-wrap: wrap; align-items: center; gap: .75rem;
        padding: .5rem 1rem; background: var(--panel); border-bottom: 1px solid var(--line);
      }
      footer { border-top: 1px solid var(--line); border-bottom: 0; }
      header h1 { font-size: 1rem; margin: 0 auto 0 0; }
      a { color: inherit; }
      button, select {
        font: inherit; padding: .35rem .75rem; border: 1px solid var(--line);
        border-radius: 4px; background: var(--panel); color: var(--text);
      }
      button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      button:disabled { opacity: .5; }
      select { max-width: 100%; }
      #gate { margin: auto; max-width: 28rem; padding: 2rem; text-align: center; }
      #app { flex: 1; display: flex; flex-direction: column; min-height: 0; }
      .panes { flex: 1; display: grid; grid-template-columns: 1fr 1fr; min-height: 0; }
      .pane { position: relative; min-height: 0; min-width: 0; display: flex; flex-direction: column; }
      .pane + .pane { border-left: 1px solid var(--line); }
      .pane h2 {
        font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em;
        margin: 0; padding: .35rem 1rem; color: var(--muted); border-bottom: 1px solid var(--line);
      }
      #code { flex: 1; min-height: 0; overflow: auto; background: var(--panel); }
      #code .cm-editor { height: 100%; font-size: 14px; }
      #preview { flex: 1; width: 100%; border: 0; background: #fff; }
      #preview-error {
        position: absolute; left: 0; right: 0; bottom: 0; margin: 0; padding: .75rem 1rem;
        white-space: pre-wrap; font: 13px/1.4 ui-monospace, monospace;
        background: var(--error-bg); color: var(--error); border-top: 1px solid var(--error);
        max-height: 40%; overflow: auto;
      }
      #status { color: var(--muted); margin-right: auto; }
      #links { display: flex; gap: .75rem; }
      @media (max-width: 800px) {
        .panes { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
        .pane + .pane { border-left: 0; border-top: 1px solid var(--line); }
      }
  body
    header
      h1 Edit Pug posts
      a(href='/admin/') Markdown pages
      button#sign-out(type='button' hidden) Sign out
    noscript
      p Editing the site needs JavaScript enabled.
    #gate(hidden)
      p Sign in with your jamesjnadeau.com site account to edit the Pug posts.
      button#sign-in.primary(type='button') Sign in
      p#gate-status(role='status')
    main#app(hidden)
      header
        label(for='entry') Post
        select#entry
      .panes
        section.pane(aria-labelledby='code-heading')
          h2#code-heading Source
          #code
        section.pane(aria-labelledby='preview-heading')
          h2#preview-heading Preview
          iframe#preview(title='Preview of the post')
          pre#preview-error(hidden role='alert')
      footer
        span#status(role='status')
        #links
        button#save.primary(type='button' disabled) Submit for review
    script(type='module' src='/cms-pug/pug-editor.js')
