doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1.0')
    meta(name='theme-color' content='#333333')
    title=title
    if description
      meta(name='description', content=description)
    if cmsEntry
      //- ContentTools: this page is an editable entry (content/_data/eleventyComputed.js).
      meta(name='cms:entry' content=cmsEntry)

    link(rel='icon' type='image/png' href='/icons/favicon-32x32.png')
    link(rel='stylesheet', href='/styles/main.css')

  body
    nav#header.navbar.navbar-expand-lg.navbar-dark.fixed-top
      .container.p-2
        a.brand.navbar-brand(href='/')
          span.h-card.u-url.u-uid(rel='me', href='https://jamesjnadeau.com/')
            | James J Nadeau
        button.navbar-toggler(type='button' data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls='navbarSupportedContent', aria-label='Toggle Main navigation')
          span.navbar-toggler-icon
        #navbarSupportedContent.navbar-collapse.collapse
          .navbar-nav.d-flex.justify-content-around.align-items-center.w-100
            a.nav-item.nav-link.text-white.p-1(href='/projects/')
              | Projects
            a.nav-item.nav-link.text-white.p-1(href='/til/')
              | Today I ...
            a.nav-item.nav-link.text-white.p-1(href='/reference/')
              | Reference
            a.nav-item.nav-link.text-white.p-1(href='https://github.com/jamesjnadeau/', rel='me')
              img.github-logo.img-fluid(alt='GitHub', src='/files/GitHub-Mark-Light-120px-plus.png')
    //- end nav
    #wrap(data-barba="wrapper")
      #container.container.md-8.animated.fadeInRight(data-barba="container" data-barba-namespace=page.url)
        if cmsEntry
          //- The editor replaces this element's children with its own render of
          //- the markdown, so it must hold the rendered body and nothing else.
          div(data-cms-body) !{content}
        else
          | !{content}

    //- Scripts
    //- Editing. Whether this visitor is an author: signed in with Netlify
    //- Identity, handed a token by /admin/, or asking with ?cms-edit. A
    //- reader's browser answers a few storage lookups here and loads nothing.
    //- Defined on every page, because it also keeps Barba off for an author
    //- (below), including on the Pug pages they navigate through.
    //-
    //- Identity's invite and password-reset emails link to the site root with
    //- a token in the fragment, and only the Identity widget can finish them,
    //- so those load it, and send the new author on to /admin/.
    script.
      window.cmsAuthoring = (function () {
        function held(storage, key) {
          try {
            return window[storage].getItem(key) !== null;
          } catch (e) {
            return false;
          }
        }
        return held('localStorage', 'gotrue.user')
          || held('sessionStorage', 'content-tools:github-token')
          || new URLSearchParams(location.search).has('cms-edit')
          || location.hash.indexOf('cms-token=') !== -1;
      })();
      if (/(confirmation|invite|recovery|email_change)_token=/.test(location.hash)) {
        var identity = document.createElement('script');
        identity.src = '/js/netlify-identity-widget.js';
        identity.onload = function () {
          window.netlifyIdentity.on('login', function () { location.href = '/admin/'; });
        };
        document.head.append(identity);
      }
    if cmsEntry
      //- The in-page editor, on a markdown page, for an author only
      //- (static/cms/boot.js loads the ContentTools package's edit.js).
      script(type='module').
        if (window.cmsAuthoring) import('/cms/boot.js');
    script(src='/js/bootstrap.bundle.min.js')
    script(src='/js/headroom.min.js')
    script(src='/js/barba.umd.js')
    script.
      //hide the header on scroll
      var init_headroom = function() {
        // grab an element
        var myElement = document.querySelector("#header");

        // global Headroom
        // construct an instance of Headroom, passing the element
        var headroom = new Headroom(myElement); // eslint-disable-line
        // initialise
        headroom.init();
      };
      init_headroom();
    script().
      var inAnimationClass = 'fadeInRight';
      var outAnimationClass = 'fadeOutLeft';
      // An author gets plain page loads. The in-page editor binds to the entry
      // it started on, and Barba swaps #container without a load, so an author
      // navigating by transition would be editing a page that is gone.
      if (!window.cmsAuthoring) barba.init({
        transitions: [{
          name: 'default-transition',
          leave(data) {
            target = data.current.container
            target.classList.remove(inAnimationClass);
            target.classList.add(outAnimationClass);
            var promise = new Promise(function(resolve, reject) {
              target.addEventListener('animationend', function(event) {
                target.style.display = 'none'; // hide leaving page after animation is complete
                resolve();
              },{once: true}); // remove event after run once
            });
            return promise;
          },
          enter(data) {
            target = data.next.container
            target.classList.remove('animated');
            var promise = new Promise(function(resolve, reject) {
              target.addEventListener('animationend', function(event) {
                resolve();
              },{once: true}); // remove event after run once
            });
            target.classList.add('animated')
            return promise;
          }
        }]
      });
